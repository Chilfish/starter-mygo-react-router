{
  "name": "starter-mygo-react-router",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Starter for MyGo desktop apps with React Router v8, coss UI, Tailwind CSS v4, and Bun.",
  "author": "Chilfish (https://github.com/Chilfish)",
  "license": "MIT",
  "homepage": "https://github.com/Chilfish/starter-mygo-react-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chilfish/starter-mygo-react-router.git"
  },
  "bugs": {
    "url": "https://github.com/Chilfish/starter-mygo-react-router/issues"
  },
  "keywords": [
    "mygo",
    "desktop",
    "go",
    "react-router",
    "tailwindcss",
    "bun",
    "template",
    "starter"
  ],
  "scripts": {
    "dev": "mygo dev",
    "dev:ios": "mygo dev -platform ios",
    "dev:android": "mygo dev -platform android",
    "build": "mygo build",
    "build:ios": "mygo build -platform ios",
    "build:android": "mygo build -platform android",
    "generate": "mygo generate",
    "doctor": "mygo doctor",
    "dev:web": "cross-env NODE_ENV=development react-router dev",
    "build:web": "cross-env NODE_ENV=production react-router build",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o .storybook-static",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "isbot": "^5.2.3",
    "lucide-react": "^1.79.0",
    "mygo-runtime": "^0.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "spin-delay": "^2.0.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@chromatic-com/storybook": "^5.6.0",
    "@react-router/dev": "^8.5.2",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/builder-vite": "10.6.5",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.2.2",
    "mygo-cli": "^0.10.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
